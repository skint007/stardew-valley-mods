<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>TrainUp</RootNamespace>
    <AssemblyName>TrainUp</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableHarmony>true</EnableHarmony>

    <!--
      The build auto-detects a standard Steam/GOG Stardew Valley install. If yours
      is in a non-standard location, do NOT hardcode it here (keeps machine-specific
      paths out of version control). Instead create a "TrainUp.csproj.user" file
      next to this one (it is git-ignored) containing:

        <Project>
          <PropertyGroup>
            <GamePath>/path/to/Stardew Valley</GamePath>
          </PropertyGroup>
        </Project>
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.3.2" />
  </ItemGroup>

  <!--
    Direct reference to SpaceCore.dll: subclassing SpaceCore.Skills.Skill (to register a
    custom skill) requires the assembly at compile time — the soft-typed ISpaceCoreApi has
    no RegisterSkill. SpaceCore is a required dependency (see manifest.json), so it is always
    present in the game's Mods folder. <Private>false</Private> keeps it out of our build
    output (SMAPI loads SpaceCore itself).
  -->
  <ItemGroup>
    <Reference Include="SpaceCore">
      <HintPath>$(GameModsPath)\SpaceCore\SpaceCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
